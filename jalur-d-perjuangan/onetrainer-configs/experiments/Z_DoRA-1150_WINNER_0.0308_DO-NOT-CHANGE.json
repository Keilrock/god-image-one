{
  "__version": 10,
  "training_method": "LORA",
  "model_type": "Z_IMAGE",
  "base_model_name": "/ephemeral/models/Z-Image",
  "weight_dtype": "BFLOAT_16",
  "train_dtype": "BFLOAT_16",
  "output_dtype": "BFLOAT_16",
  "output_model_format": "SAFETENSORS",
  "output_model_destination": "/ephemeral/work/out/dora_T2_z.safetensors",
  "concept_file_name": "/ephemeral/work/concepts_z.json",
  "workspace_dir": "/ephemeral/work/workspace/train_T2_z",
  "cache_dir": "/ephemeral/work/cache/train_T2_z",
  "peft_type": "LORA",
  "lora_rank": 16,
  "lora_alpha": 16.0,
  "lora_decompose": true,
  "lora_weight_dtype": "BFLOAT_16",
  "layer_filter": "^(?=.*attention)(?!.*refiner).*,^(?=.*feed_forward)(?!.*refiner).*",
  "layer_filter_preset": "attn-mlp",
  "layer_filter_regex": true,
  "transformer": {
    "train": true,
    "weight_dtype": "FLOAT_8"
  },
  "text_encoder": {
    "train": false,
    "weight_dtype": "FLOAT_8"
  },
  "vae": {
    "weight_dtype": "FLOAT_32"
  },
  "quantization": {
    "layer_filter": "layers",
    "layer_filter_preset": "blocks"
  },
  "gradient_checkpointing": "ON",
  "layer_offload_fraction": 0.0,
  "compile": false,
  "resolution": "1024",
  "batch_size": 2,
  "dataloader_threads": 1,
  "learning_rate": 0.0003,
  "learning_rate_scheduler": "CONSTANT",
  "optimizer": {
    "optimizer": "ADAMW",
    "stochastic_rounding": true
  },
  "timestep_distribution": "LOGIT_NORMAL",
  "epochs": 64,
  "backup_after_unit": "NEVER",
  "backup_before_save": false,
  "rolling_backup": false,
  "save_every_unit": "STEP",
  "sample_after_unit": "NEVER",
  "sample_skip_first": 100000,
  "samples_to_tensorboard": false,
  "validation": false,
  "dropout_probability": 0.05,
  "debug_dir": "/ephemeral/work/debug/train_T2_z",
  "tensorboard": false,
  "latent_caching": true,
  "clear_cache_before_training": true,
  "save_every": 10,
  "save_skip_first": 580,
  "save_filename_prefix": "T2_"
}