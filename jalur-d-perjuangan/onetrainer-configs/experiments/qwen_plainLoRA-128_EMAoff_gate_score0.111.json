{
  "__version": 10,
  "training_method": "LORA",
  "model_type": "QWEN",
  "base_model_name": "/ephemeral/models/Qwen-Image",
  "weight_dtype": "BFLOAT_16",
  "train_dtype": "BFLOAT_16",
  "output_dtype": "BFLOAT_16",
  "output_model_format": "SAFETENSORS",
  "output_model_destination": "/ephemeral/work/out/lora_T1G_qwen.safetensors",
  "concept_file_name": "/ephemeral/work/concepts_qwen.json",
  "peft_type": "LORA",
